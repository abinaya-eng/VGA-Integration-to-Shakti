`timescale 1ns / 1ps

module tb_axi4_vga();

    reg clk = 0;
    reg reset = 1;

    // AXI4 signals
    reg [18:0] s_axi_awaddr;
    reg s_axi_awvalid;
    wire s_axi_awready;

    reg [7:0] s_axi_wdata;
    reg s_axi_wvalid;
    wire s_axi_wready;

    wire [1:0] s_axi_bresp;
    wire s_axi_bvalid;
    reg s_axi_bready;

    reg [18:0] s_axi_araddr;
    reg s_axi_arvalid;
    wire s_axi_arready;

    wire [7:0] s_axi_rdata;
    wire [1:0] s_axi_rresp;
    wire s_axi_rvalid;
    reg s_axi_rready;

    wire hsync, vsync;
    wire [7:0] rgb;

    // Instantiate DUT
    axi4_vga uut (
        .clk(clk),
        .reset(reset),

        .s_axi_awaddr(s_axi_awaddr),
        .s_axi_awvalid(s_axi_awvalid),
        .s_axi_awready(s_axi_awready),

        .s_axi_wdata(s_axi_wdata),
        .s_axi_wvalid(s_axi_wvalid),
        .s_axi_wready(s_axi_wready),

        .s_axi_bresp(s_axi_bresp),
        .s_axi_bvalid(s_axi_bvalid),
        .s_axi_bready(s_axi_bready),

        .s_axi_araddr(s_axi_araddr),
        .s_axi_arvalid(s_axi_arvalid),
        .s_axi_arready(s_axi_arready),

        .s_axi_rdata(s_axi_rdata),
        .s_axi_rresp(s_axi_rresp),
        .s_axi_rvalid(s_axi_rvalid),
        .s_axi_rready(s_axi_rready),

        .hsync(hsync),
        .vsync(vsync),
        .rgb(rgb)
    );

    // Clock generation
    always #5 clk = ~clk; // 100 MHz clock

    // AXI4 write task
    task axi_write(
        input [18:0] addr,
        input [7:0]  data
    );
    begin
        // Address phase
        @(posedge clk);
        s_axi_awaddr  <= addr;
        s_axi_awvalid <= 1;
        wait(s_axi_awready == 1);
        @(posedge clk);
        s_axi_awvalid <= 0;

        // Data phase
        @(posedge clk);
        s_axi_wdata  <= data;
        s_axi_wvalid <= 1;
        wait(s_axi_wready == 1);
        @(posedge clk);
        s_axi_wvalid <= 0;

        // Response phase
        s_axi_bready <= 1;
        wait(s_axi_bvalid == 1);
        @(posedge clk);
        s_axi_bready <= 0;
    end
    endtask

    initial begin
        // Init signals
        s_axi_awaddr  = 0;
        s_axi_awvalid = 0;
        s_axi_wdata   = 0;
        s_axi_wvalid  = 0;
        s_axi_bready  = 0;
        s_axi_araddr  = 0;
        s_axi_arvalid = 0;
        s_axi_rready  = 0;

        // Reset pulse
        #20 reset = 0;

        // Write a few pixels into frame buffer
        axi_write(0, 8'hFF); // pixel (0,0) = white
        axi_write(1, 8'h80); // pixel (1,0) = dark gray
        axi_write(2, 8'h40); // pixel (2,0) = darker gray

        // Let VGA run for some cycles
        #5000;

        $stop;
    end

endmodule
