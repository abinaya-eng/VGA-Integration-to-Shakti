`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// Engineer: Abinaya's VGA Module Update
// Description: AXI4 VGA controller with default test pattern
//////////////////////////////////////////////////////////////////////////////////

module axi4_vga #(
    parameter H_ACTIVE = 4,   // default 640
    parameter V_ACTIVE = 2,   // default 480
    parameter ADDR_WIDTH = 19,
    parameter DATA_WIDTH = 8
)(
    input  wire                   clk,
    input  wire                   reset,

    // AXI4 Slave Interface
    input  wire [ADDR_WIDTH-1:0]  s_axi_awaddr,
    input  wire                   s_axi_awvalid,
    output reg                    s_axi_awready,

    input  wire [DATA_WIDTH-1:0]  s_axi_wdata,
    input  wire                   s_axi_wvalid,
    output reg                    s_axi_wready,

    output reg  [1:0]             s_axi_bresp,
    output reg                    s_axi_bvalid,
    input  wire                   s_axi_bready,

    input  wire [ADDR_WIDTH-1:0]  s_axi_araddr,
    input  wire                   s_axi_arvalid,
    output reg                    s_axi_arready,

    output reg [DATA_WIDTH-1:0]   s_axi_rdata,
    output reg [1:0]              s_axi_rresp,
    output reg                    s_axi_rvalid,
    input  wire                   s_axi_rready,

    // VGA Outputs
    output reg                    hsync,
    output reg                    vsync,
    output reg [7:0]              rgb
);

    // VGA Timing Parameters
    parameter H_FRONT  = 16;
    parameter H_SYNC   = 96;
    parameter H_BACK   = 48;
    parameter H_TOTAL  = H_ACTIVE + H_FRONT + H_SYNC + H_BACK;

    parameter V_FRONT  = 10;
    parameter V_SYNC   = 2;
    parameter V_BACK   = 33;
    parameter V_TOTAL  = V_ACTIVE + V_FRONT + V_SYNC + V_BACK;

    reg [9:0] h_count = 0;
    reg [9:0] v_count = 0;

    // Frame buffer in BRAM
    reg [7:0] frame_buffer [0:(H_ACTIVE*V_ACTIVE)-1];

    // =========================
    // Initialize frame buffer
    // =========================
    integer i;
    initial begin
        for (i = 0; i < (H_ACTIVE*V_ACTIVE); i = i + 1) begin
            frame_buffer[i] = 8'h00; // Black
        end
    end

    // =========================
    // AXI4 WRITE Logic
    // =========================
    always @(posedge clk) begin
        if (reset) begin
            s_axi_awready <= 0;
            s_axi_wready  <= 0;
            s_axi_bvalid  <= 0;
            s_axi_bresp   <= 2'b00;
        end else begin
            if (!s_axi_awready && s_axi_awvalid)
                s_axi_awready <= 1;
            else
                s_axi_awready <= 0;

            if (!s_axi_wready && s_axi_wvalid) begin
                frame_buffer[s_axi_awaddr] <= s_axi_wdata;
                s_axi_wready <= 1;
                s_axi_bvalid <= 1;
                s_axi_bresp  <= 2'b00;
            end else begin
                s_axi_wready <= 0;
            end

            if (s_axi_bvalid && s_axi_bready)
                s_axi_bvalid <= 0;
        end
    end

    // =========================
    // AXI4 READ Logic
    // =========================
    always @(posedge clk) begin
        if (reset) begin
            s_axi_arready <= 0;
            s_axi_rvalid  <= 0;
            s_axi_rresp   <= 2'b00;
        end else begin
            if (!s_axi_arready && s_axi_arvalid) begin
                s_axi_arready <= 1;
                s_axi_rdata   <= frame_buffer[s_axi_araddr];
                s_axi_rvalid  <= 1;
                s_axi_rresp   <= 2'b00;
            end else begin
                s_axi_arready <= 0;
            end

            if (s_axi_rvalid && s_axi_rready)
                s_axi_rvalid <= 0;
        end
    end

    // =========================
    // VGA Timing
    // =========================
    always @(posedge clk) begin
        if (reset) begin
            h_count <= 0;
            v_count <= 0;
        end else begin
            if (h_count == H_TOTAL - 1) begin
                h_count <= 0;
                if (v_count == V_TOTAL - 1)
                    v_count <= 0;
                else
                    v_count <= v_count + 1;
            end else begin
                h_count <= h_count + 1;
            end
        end
    end

    // Sync pulses
    always @(posedge clk) begin
        hsync <= ~(h_count >= (H_ACTIVE + H_FRONT) &&
                   h_count <  (H_ACTIVE + H_FRONT + H_SYNC));

        vsync <= ~(v_count >= (V_ACTIVE + V_FRONT) &&
                   v_count <  (V_ACTIVE + V_FRONT + V_SYNC));
    end

    // =========================
    // RGB Output (Test Pattern + AXI data)
    // =========================
    always @(posedge clk) begin
        if (reset) begin
            rgb <= 8'h00;
        end else if (h_count < H_ACTIVE && v_count < V_ACTIVE) begin
            // Use frame buffer value if written, else show test pattern
            if (frame_buffer[v_count * H_ACTIVE + h_count] !== 8'h00)
                rgb <= frame_buffer[v_count * H_ACTIVE + h_count];
            else
                rgb <= h_count[7:0]; // horizontal gradient test pattern
        end else begin
            rgb <= 8'h00;
        end
    end

endmodule
